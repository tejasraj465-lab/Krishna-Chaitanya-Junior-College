# Copy values into your shell BEFORE npm run build:hostinger
# PowerShell:
#   $env:VITE_SITE_URL="https://www.yourdomain.com"
# Then:
#   npm.cmd run build:hostinger

VITE_SITE_URL=https://www.yourdomain.com

# Google Tag Manager — paste GTM-XXXXXXX from tagmanager.google.com
VITE_GTM_ID=

# Google Search Console — paste the content= value from the HTML verification meta tag
VITE_GOOGLE_SITE_VERIFICATION=
