# Server-side only (never expose to the browser)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public production URL (optional — used for deployment metadata)
APP_URL="https://kcjc-phi.vercel.app"

# Local development
# PORT=3000

# Notes:
# - Configure GEMINI_API_KEY in Vercel Project Settings → Environment Variables.
# - Do not commit .env, .env.local, or any file containing real secrets.
# - Preview and production secrets should be managed separately in Vercel when possible.
