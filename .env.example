# Server-side only (never expose to the browser)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public production URL used in sitemap.xml, RSS feeds, and canonical tags
VITE_SITE_URL="https://krishna-chaitanya-junior-college.vercel.app"
APP_URL="https://krishna-chaitanya-junior-college.vercel.app"

# Local development
# PORT=3000

# Hostinger
# 1. Set VITE_SITE_URL to your live domain, e.g. https://www.yourdomain.com
# 2. Run: npm run build:hostinger
# 3. Upload ALL files inside dist/ into public_html
# 4. Optional AI chat: copy api/gemini-config.example.php to api/gemini-config.php and add the Gemini key
# 5. Submit sitemap.xml and /feeds/*.xml in Google Search Console and Bing Webmaster (Yahoo uses Bing)

# Notes:
# - Do not commit .env, .env.local, gemini-config.php, or any file containing real secrets.
# - Preview and production secrets should be managed separately.
